# --- Development lokal ---
# Koneksi PostgreSQL
DATABASE_URL=postgres://sisar:sisar@localhost:5433/sisar_matiti
# Rahasia untuk memanggil endpoint job harian (/api/cron/harian), minimal 16 karakter
CRON_SECRET=ganti-dengan-string-acak-panjang

# --- Produksi (docker-compose.yml) ---
POSTGRES_USER=sisar
POSTGRES_PASSWORD=ganti-password-db-yang-kuat
POSTGRES_DB=sisar_matiti
# Isi 1 hanya bila aplikasi diakses tanpa HTTPS (tidak disarankan)
# COOKIE_INSECURE=1
